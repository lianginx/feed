# === 主进程：开发行为开关 =============
# 全部为 1=开启 0=关闭，未配置或空值视为关闭。
# 命令行同名环境变量（FEED_ENABLE_*）可临时覆盖。

# 定时刷新开关：开启后按设置周期自动刷新所有订阅源。
# 开发默认关闭（频繁重启会重复请求源站，刷新走手动/菜单触发）。
MAIN_VITE_ENABLE_SCHEDULER=0

# 自动更新开关：开启后启动延迟数秒静默检查更新，并按周期检查。
# 开发默认关闭（无打包版本可查）。
MAIN_VITE_ENABLE_UPDATER=0

# 「开发者工具」菜单开关：开启后在应用菜单「视图」显示开发者工具入口。
# 开发默认开启；生产排查问题时可临时用命令行 FEED_ENABLE_DEVTOOLS=1 覆盖。
MAIN_VITE_ENABLE_DEVTOOLS=1

# === 主进程：IPC 日志 =================
# 级别：off=关闭 error=仅错误 info=常规 debug=全部（含高频只读通道）。
# 生产默认 off；排查问题时用命令行 FEED_IPC_LOG=debug 覆盖。
MAIN_VITE_IPC_LOG=info

# 需要打印完整参数/返回值的 IPC 通道，逗号分隔（如 articles:list,translate:article）。
# 空=不深挖。
MAIN_VITE_IPC_LOG_DETAIL=

# === 渲染进程 =========================
# 暂无

# ======================================
