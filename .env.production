# === 主进程：生产行为开关 =============

# 定时刷新订阅开关
MAIN_VITE_ENABLE_SCHEDULER=1

# 启动时自动更新订阅
MAIN_VITE_ENABLE_UPDATER=1

# 「开发者工具」菜单
MAIN_VITE_ENABLE_DEVTOOLS=0

# 显示浏览器抓取窗口
MAIN_VITE_DEBUG_FETCH_WINDOW=0

# 显示浏览器抓取进度日志
MAIN_VITE_DEBUG_FETCH_LOG=0

# === 主进程：IPC 日志 =================

# 级别：off/error/info/debug
MAIN_VITE_IPC_LOG=off

# 需要打印完整参数/返回值的 IPC 通道
# 逗号分隔（如 articles:list,translate:article）。
MAIN_VITE_IPC_LOG_DETAIL=

# === 意见反馈 =========================

# 反馈后端地址，留空则隐藏反馈入口。
# 开源用户自托管时改这里，或新建 .env.production.local 覆盖（已被 gitignore）。
MAIN_VITE_FEEDBACK_API_BASE_URL=https://feedback.in-x.cc

# === 渲染进程 =========================
# 暂无
# ======================================
